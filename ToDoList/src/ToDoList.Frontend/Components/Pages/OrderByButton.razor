@using ToDoList.Frontend.Models
<PageTitle>Order by Button</PageTitle>

<button class="btn btn-primary ml-10" @onclick="Order"><i class="bi bi-arrow-down"></i></button>

@code {

    [Parameter]
    public string Field { get; set; }

    [Parameter]
    public List<ToDoItemView> List { get; set; }

    // EventCallback matching the bind- pattern -> @bind-List in parent
    [Parameter]
    public EventCallback<List<ToDoItemView>> ListChanged { get; set; }

    private IToDoItemSorter sorter = new OrderById();

    protected override void OnInitialized()
    {
        sorter = Field switch
        {
            "name" => new OrderByName(),
            _ => new OrderById()
        };

        List ??= new List<ToDoItemView>();
    }

    private async Task Order()
    {
        var ordered = sorter.Order(List);
        List.Clear();
        List.AddRange(ordered);

        // notify parent so it re-renders with the updated list
        await ListChanged.InvokeAsync(List);
    }
}
