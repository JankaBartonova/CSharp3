    private List<ToDoItemView> sortedData = new List<ToDoItemView>();

    protected override async Task OnInitializedAsync()
    {
        //sortedData = testData.ToList();
        sortedData = await ToDoItemsClient.ReadItemsAsync();
    }

    public void EditItem(ToDoItemView item)
    {
        NavigationManager.NavigateTo($"/editToDoItem/{item.Id}");
    }

    public void DeleteItem(ToDoItemView item)
    {
        NavigationManager.NavigateTo($"/deleteToDoItem/{item.Id}");
    }

    public async Task ToggleItemFinishedAsync(ToDoItemView item)
    {
        var updatedItem = new ToDoItemView
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            IsCompleted = !item.IsCompleted
        };
        await ToDoItemsClient.UpdateItemAsync(updatedItem);

        sortedData = await ToDoItemsClient.ReadItemsAsync();

        // OR update data locally without reloading from server
        /*var index = sortedData.FindIndex(i => i.Id == item.Id);
        if (index >= 0)
        {
        sortedData[index].IsCompleted = updatedItem.IsCompleted;
        }
        StateHasChanged();*/
    }

    /*private void OrderById()
    {
    sortedData = sortedData.OrderBy(item => item.Id).ToList();
    }

    private void OrderByName()
    {
    sortedData = sortedData.OrderBy(item => item.Name).ToList();
    }*/

    private void OrderById()
    {
        IToDoItemSorter sorter = new OrderById();
        sortedData = sorter.Order(sortedData);
    }

    private void OrderByName()
    {
        IToDoItemSorter sorter = new OrderByName();
        sortedData = sorter.Order(sortedData);
    }
}
