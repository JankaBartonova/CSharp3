@using System.Threading.Tasks
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient ToDoItemsClient
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

<h1 class="text-primary">Dashboard</h1>

<div>
    <h2 class="text-primary">ToDo items dashboard</h2>
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID
                    <OrderByButton Field="id" @bind-List="sortedData" />
                </th>
                <th>Name
                    <OrderByButton Field="name" @bind-List="sortedData" />
                </th>
                <th>Description</th>
                <th>Status</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-secondary">
            @foreach (var item in sortedData)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Done!" : "Waiting")</td>
                    <td>@item.Category</td>
                    <td>
                        <input class="form-check-input fs-1 mt-0" type="checkbox" checked="@item.IsCompleted"
                            @onchange="async () => await ToggleItemFinishedAsync(item)" />
                        <button class="btn btn-success" @onclick="() => EditItem(item)">
                            <i class="bi bi-pencil-fill"></i></button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(item)">
                            <i class="bi bi-x-square-fill"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <button class="btn btn-primary" @onclick="() => CreateItem()"><i class="bi bi-plus-lg"></i></button>
</div>

@code {
    private List<ToDoItemView> sortedData = new List<ToDoItemView>();

    protected override async Task OnInitializedAsync()
    {
        sortedData = await ToDoItemsClient.ReadItemsAsync();
    }

    public void CreateItem()
    {
        NavigationManager.NavigateTo($"/createToDoItem");
    }

    public void EditItem(ToDoItemView item)
    {
        NavigationManager.NavigateTo($"/editToDoItem/{item.Id}");
    }

    public void DeleteItem(ToDoItemView item)
    {
        NavigationManager.NavigateTo($"/deleteToDoItem/{item.Id}");
    }

    public async Task ToggleItemFinishedAsync(ToDoItemView item)
    {
        var updatedItem = new ToDoItemView
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            Category = item.Category,
            IsCompleted = !item.IsCompleted
        };
        await ToDoItemsClient.UpdateItemAsync(updatedItem);
        sortedData = await ToDoItemsClient.ReadItemsAsync();
    }

    private void OrderById()
    {
        IToDoItemSorter sorter = new OrderById();
        sortedData = sorter.Order(sortedData);
    }

    private void OrderByName()
    {
        IToDoItemSorter sorter = new OrderByName();
        sortedData = sorter.Order(sortedData);
    }
}